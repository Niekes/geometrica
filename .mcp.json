{
    "mcpServers": {
        "chrome-devtools": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest",
                "--categoryExperimentalWebmcp=true",
                "--chromeArg=--enable-features=WebMCP"
            ]
        }
    }
}

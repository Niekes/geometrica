{
    "name": "geometrica",
    "version": "1.2.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "reset": "rm -rf node_modules && npm install && npm dedupe",
        "build-only": "vite build",
        "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
        "lint": "eslint . && npm run lint:fallow",
        "format": "prettier --write src/",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "lint:fix": "eslint . --fix",
        "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow architecture --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
        "hooks:install": "fallow hooks install --target git"
    },
    "dependencies": {
        "@heroicons/vue": "^2.2.0",
        "d3": "^7.9.0",
        "d3-scale-chromatic": "^3.1.0",
        "daisyui": "^5.7.50",
        "lz-string": "^1.5.0",
        "qs": "^6.17.0",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tsconfig/node22": "^22.0.6",
        "@types/d3": "^7.4.3",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/qs": "^6.15.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitejs/plugin-vue-jsx": "^5.1.6",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.12.0",
        "fallow": "^3.36.0",
        "jsdom": "^30.1.3",
        "npm-run-all2": "^9.0.4",
        "prettier": "^3.9.10",
        "typescript": "~5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || ^24.11.0 || >=26.0.0"
        }
    }
}
